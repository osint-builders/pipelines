      ]
    },
    "threshold_grid": {
      "maximum_values_per_feature": 64,
      "selection": "sorted unique observed integers and their successors plus lower bound; if over 64 select floor(i*(n-1)/63), i=0..63"
    },
    "features": {
      "text": [
        "semantic_cosine",
        "ranking_margin"
      ],
      "image": [
        "image_cosine",
        "ranking_margin"
      ],
